# Application Configuration
PORT=8080

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/express-boilerplate

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=expressJsRestApi
